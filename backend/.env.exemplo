# Banco de dados
DATABASE_URL=postgresql://usuario:senha@localhost:5432/nome_do_banco

# Autenticação JWT
SECRET_KEY=sua-chave-secreta-aqui

# Cloudinary (upload de mídia)
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
# Mostrar todo o SQL no log (true/false, padrão false)
SQL_ECHO=false

# Expiração do token JWT em minutos (padrão 30)
JWT_EXPIRA_MINUTOS=30
# Origens permitidas no CORS, separadas por vírgula. Vazio ou * libera tudo (sem credenciais)
CORS_ORIGINS=
# Fuso usado em "treino de hoje" e datas geradas (padrão America/Sao_Paulo)
APP_TIMEZONE=America/Sao_Paulo
